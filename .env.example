# Copier ce fichier en « .env.local » et renseigner les valeurs (voir src/modules/sync/README.md).
# Sans ces variables, l'application fonctionne entièrement en local (pas de synchro Google Drive).

# ID client OAuth de type « Application Web » (se termine par .apps.googleusercontent.com).
# Active la connexion Google et la synchronisation.
VITE_GOOGLE_CLIENT_ID=

# Clé API Google Cloud. Active en plus l'import de fichiers depuis Drive (Google Picker).
VITE_GOOGLE_API_KEY=

# Optionnel : numéro du projet Google Cloud (recommandé pour le Picker).
VITE_GOOGLE_APP_ID=
